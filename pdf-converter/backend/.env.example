# Copy this file to .env and fill in the appropriate value.

# Option 1: Your Anthropic API key (https://console.anthropic.com)
# ANTHROPIC_API_KEY=sk-ant-...

# Option 2: Claude Code on the web — path to the session ingress token file
# CLAUDE_SESSION_INGRESS_TOKEN_FILE=/home/claude/.claude/remote/.session_ingress_token

# Server port (default: 3001)
PORT=3001
